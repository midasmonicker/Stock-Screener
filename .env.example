# ==============================================================================
# Antigravity Stock Market Data Service Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary Tier: Real-time US Quotes
# ------------------------------------------------------------------------------
# Alpaca Market Data v2 (Recommended Primary)
# Sign up: https://alpaca.markets/
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets

# Finnhub Stock API (Alternative Primary)
# Sign up: https://finnhub.io/
FINNHUB_API_KEY=

# ------------------------------------------------------------------------------
# Backup Tier: Fundamentals and Delayed Data
# ------------------------------------------------------------------------------
# Financial Modeling Prep (FMP)
# Sign up: https://financialmodelingprep.com/
FMP_API_KEY=

# EODHD (EOD Historical Data)
# Sign up: https://eodhd.com/
EODHD_API_KEY=

# ------------------------------------------------------------------------------
# Screening Metrics Tier: Finviz (via finvizfinance Python wrapper)
# ------------------------------------------------------------------------------
# Finviz scraping does not require an API key.
# Optional: Path to custom Python executable (defaults to .venv/Scripts/python.exe or system python)
# PYTHON_PATH=C:\Users\MidasMonicker\Documents\Antigravity\.venv\Scripts\python.exe

# ------------------------------------------------------------------------------
# Fallback Tier: Polygon Free Tier (Delayed OHLCV)
# ------------------------------------------------------------------------------
# Polygon.io
# Sign up: https://polygon.io/
POLYGON_API_KEY=
